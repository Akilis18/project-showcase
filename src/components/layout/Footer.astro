---
import { site } from '../../data/site';
---
<footer class="container"><span>© {new Date().getUTCFullYear()} {site.title}</span><a href={site.repository}>View source <span aria-hidden="true">↗</span></a><span>Built with Astro · Designed to grow</span></footer>
<style>footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-6); border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: .8rem; } footer a { min-height: 44px; display: inline-flex; align-items: center; gap: var(--space-2); }</style>
