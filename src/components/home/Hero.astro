---
import { site } from '../../data/site';
---
<section class="hero" aria-labelledby="hero-title"><div>
  <span class="eyebrow">Developer portfolio / Selected work</span>
  <h1 id="hero-title">Ideas into code.<br /><span>Code into projects.</span></h1>
  <p lang="zh-TW">{site.description}<br />從想法到實作，留下每一步的思考與探索。</p>
  <div class="actions"><a class="button primary" href="#projects">Explore projects <span aria-hidden="true">↘</span></a><a class="button" href="#about">About {site.name || 'this portfolio'}</a></div>
</div><div class="hero-art" aria-hidden="true"><span class="art-caption">FROM CONCEPT TO COMMIT</span><div class="code-mark">&lt;<span>/</span>&gt;</div><div class="art-bottom"><span>think. build. iterate.</span><span>01 — ∞</span></div></div></section>
<style>
  .hero { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: var(--space-7); padding-block: 6rem; }
  h1 { margin-bottom: var(--space-5); } h1 span { color: var(--color-muted); }
  p { max-width: 36rem; margin-bottom: var(--space-6); }
  .hero-art { min-height: 350px; padding: var(--space-5); display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border); border-radius: var(--radius); background: radial-gradient(ellipse at center, var(--color-surface), var(--color-bg)); transform: rotate(3deg); }
  .art-caption, .art-bottom { font: .65rem var(--font-mono); color: var(--color-muted); letter-spacing: .1em; }
  .code-mark { text-align: center; font: clamp(5rem, 10vw, 9rem) var(--font-mono); color: var(--color-focus); letter-spacing: -.12em; } .code-mark span { color: var(--color-accent); }
  .art-bottom { display: flex; justify-content: space-between; gap: var(--space-3); }
  @media (max-width: 55rem) { .hero { grid-template-columns: 1fr; padding-block: var(--space-8); } .hero-art { display: none; } }
</style>
