---
import { site } from '../../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <span class="eyebrow">Developer portfolio / Selected work</span>
  <h1 id="hero-title">{site.name || 'Projects & experiments.'}</h1>
  <p lang="zh-TW">{site.description}</p>
  {!site.name && <p class="pending" lang="zh-TW">公開姓名與個人介紹尚待確認。</p>}
  <div class="actions"><a class="button primary" href="#projects">Explore projects <span aria-hidden="true">↘</span></a><a class="button" href="#contact">Contact <span aria-hidden="true">↗</span></a></div>
</section>
<style>
  .hero { padding-block: var(--space-7); }
  h1 { font-size: clamp(2.25rem, 6vw, 4rem); max-width: 18ch; margin-bottom: var(--space-4); }
  p { max-width: 40rem; margin-bottom: var(--space-4); }
  .pending { font-size: .8rem; }
  .actions { margin-top: var(--space-5); }
</style>
