---
import type { Project } from '../../utils/projects';
import { statusLabels } from '../../utils/projects';
import { localUrl, projectUrl } from '../../utils/urls';
interface Props { project: Project }
const { project: { id, data } } = Astro.props;
---
<article class="project-card" data-project-card data-title={data.title} data-summary={data.summary} data-tags={JSON.stringify(data.tags)} data-category={data.category}>
  <img src={localUrl(data.coverImage)} alt={data.coverAlt} lang="zh-TW" width="960" height="540" loading="lazy" />
  <div class="card-body"><div class="meta"><span>{data.category}</span><span>{statusLabels[data.status]}</span></div><h3><a href={projectUrl(id)}>{data.title} <span aria-hidden="true">↗</span></a></h3><p lang="zh-TW">{data.summary}</p><div class="feature"><span class="eyebrow">Key feature</span><p lang="zh-TW">{data.features[0]}</p></div><ul class="tags" aria-label="Technologies">{data.tags.map((tag) => <li>{tag}</li>)}</ul><time datetime={data.date}>{data.date}</time></div>
</article>
<style>
  article { min-width: 0; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; transition: transform var(--transition), border-color var(--transition); }
  article:hover { transform: translateY(-4px); border-color: var(--color-primary); }
  img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .card-body { padding: var(--space-5); overflow-wrap: anywhere; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: space-between; font-size: .7rem; color: var(--color-focus); margin-bottom: var(--space-4); }
  h3 a { display: flex; justify-content: space-between; gap: var(--space-3); text-decoration: none; min-height: 44px; }
  p { font-size: .9rem; } time { font: .75rem var(--font-mono); color: var(--color-muted); }
  .feature { border-top: 1px solid var(--color-border); padding-top: var(--space-4); }
  .feature .eyebrow { font-size: .65rem; margin-bottom: var(--space-2); }
</style>
